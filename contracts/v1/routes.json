{
  "description": "Route table for API v1 (docs/03). Source for openapi.json, generated by scripts/build_openapi.py; edit this file, then regenerate. access: session (cookie + role check), public (no login, rate-limited), signature (provider webhook). roles lists every role allowed; the backend enforces it, the console only mirrors it. Session mutations also need the X-CSRF-Token header.",
  "version": "1.3.0",
  "all_roles": ["admin", "researcher", "moderator", "publisher", "analyst"],
  "routes": [
    { "operation_id": "login", "method": "POST", "path": "/v1/auth/login", "tag": "auth", "summary": "Start a session", "access": "public", "roles": [], "request": "api.schema.json#/$defs/LoginRequest", "responses": { "200": "api.schema.json#/$defs/AuthSession" }, "errors": [401, 422, 429] },
    { "operation_id": "logout", "method": "POST", "path": "/v1/auth/logout", "tag": "auth", "summary": "End the session", "access": "session", "roles": "all", "responses": { "204": null }, "errors": [] },
    { "operation_id": "getMe", "method": "GET", "path": "/v1/auth/me", "tag": "auth", "summary": "Current user and roles", "access": "session", "roles": "all", "responses": { "200": "api.schema.json#/$defs/UserView" }, "errors": [] },

    { "operation_id": "importProjects", "method": "POST", "path": "/v1/projects/import", "tag": "projects", "summary": "Import the five-project input file; creates or updates catalogue records", "access": "session", "roles": ["researcher", "admin"], "idempotent": true, "request": "catalogue.schema.json#/$defs/ProjectInputFile", "responses": { "200": "api.schema.json#/$defs/ImportResult" }, "errors": [409, 422] },
    { "operation_id": "createProject", "method": "POST", "path": "/v1/projects", "tag": "projects", "summary": "Add one project from the console (D58); same fields as the input file, state optional", "access": "session", "roles": ["researcher", "admin"], "idempotent": true, "request": "catalogue.schema.json#/$defs/ProjectInput", "responses": { "201": "api.schema.json#/$defs/ImportResult" }, "errors": [409, 422] },
    { "operation_id": "listProjects", "method": "GET", "path": "/v1/projects", "tag": "projects", "summary": "Portfolio with run, review, coverage and publication summary", "access": "session", "roles": "all", "query": ["cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/ProjectPage" }, "errors": [422] },
    { "operation_id": "getProject", "method": "GET", "path": "/v1/projects/{project_id}", "tag": "projects", "summary": "Project record and configuration", "access": "session", "roles": "all", "responses": { "200": "api.schema.json#/$defs/ProjectDetail" }, "errors": [404] },
    { "operation_id": "updateProjectConfig", "method": "PATCH", "path": "/v1/projects/{project_id}", "tag": "projects", "summary": "Change configuration at an expected version", "access": "session", "roles": ["researcher"], "request": "api.schema.json#/$defs/ProjectConfigPatch", "responses": { "200": "catalogue.schema.json#/$defs/ProjectConfig" }, "errors": [404, 409, 422] },

    { "operation_id": "startRun", "method": "POST", "path": "/v1/projects/{project_id}/runs", "tag": "runs", "summary": "Start a collection and analysis run within entitlements", "access": "session", "roles": ["researcher"], "idempotent": true, "request": "api.schema.json#/$defs/RunRequest", "responses": { "202": "api.schema.json#/$defs/Accepted" }, "errors": [404, 409, 422] },
    { "operation_id": "listRuns", "method": "GET", "path": "/v1/projects/{project_id}/runs", "tag": "runs", "summary": "Runs for a project, newest first", "access": "session", "roles": "all", "query": ["cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/RunPage" }, "errors": [404, 422] },
    { "operation_id": "getRun", "method": "GET", "path": "/v1/runs/{run_id}", "tag": "runs", "summary": "Run stage, coverage, progress, errors and cost", "access": "session", "roles": "all", "responses": { "200": "operations.schema.json#/$defs/WorkflowRun" }, "errors": [404] },
    { "operation_id": "streamRunEvents", "method": "GET", "path": "/v1/runs/{run_id}/events", "tag": "runs", "summary": "Server-sent run events; resume with Last-Event-ID. Polling getRun is the fallback", "access": "session", "roles": "all", "sse": true, "responses": { "200": "api.schema.json#/$defs/RunEvent" }, "errors": [404] },
    { "operation_id": "continueAnalysis", "method": "POST", "path": "/v1/runs/{run_id}/analysis", "tag": "runs", "summary": "Continue an analysis that stopped (model budget or model access) from its last checkpoint; finished tasks are reused, nothing is paid twice", "access": "session", "roles": ["researcher"], "responses": { "202": "api.schema.json#/$defs/Accepted" }, "errors": [404, 409] },
    { "operation_id": "cancelRun", "method": "POST", "path": "/v1/runs/{run_id}/cancel", "tag": "runs", "summary": "Cooperative cancellation; valid results are kept", "access": "session", "roles": ["researcher"], "request": "api.schema.json#/$defs/ReasonRequest", "responses": { "202": "api.schema.json#/$defs/Accepted" }, "errors": [404, 409, 422] },

    { "operation_id": "listSources", "method": "GET", "path": "/v1/projects/{project_id}/sources", "tag": "sources", "summary": "Sources linked to a project, filtered", "access": "session", "roles": "all", "query": ["connector_id", "source_kind", "aspect", "language", "published_from", "published_to", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/SourcePage" }, "errors": [404, 422] },
    { "operation_id": "getSourceRevision", "method": "GET", "path": "/v1/sources/{source_id}/revisions/{revision}", "tag": "sources", "summary": "Permitted source detail, project-scoped links and evidence", "access": "session", "roles": "all", "responses": { "200": "api.schema.json#/$defs/SourceRevisionDetail" }, "errors": [404] },
    { "operation_id": "listMedia", "method": "GET", "path": "/v1/projects/{project_id}/media", "tag": "media", "summary": "Video and Short library with access and analysis status", "access": "session", "roles": "all", "query": ["access_status", "format", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/MediaPage" }, "errors": [404, 422] },
    { "operation_id": "withdrawSource", "method": "POST", "path": "/v1/sources/{source_id}/withdrawals", "tag": "sources", "summary": "Withdraw a source; dependencies are invalidated before erasure", "access": "session", "roles": ["moderator", "admin"], "idempotent": true, "request": "api.schema.json#/$defs/WithdrawalRequest", "responses": { "202": "api.schema.json#/$defs/Accepted" }, "errors": [404, 409, 422] },

    { "operation_id": "decideSourceLink", "method": "POST", "path": "/v1/project-source-links/{link_id}/decisions", "tag": "links", "summary": "Accept, reject, split or remap a project association", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/LinkDecisionRequest", "responses": { "200": "sources.schema.json#/$defs/ProjectSourceLink" }, "errors": [404, 409, 422] },
    { "operation_id": "listAliasProposals", "method": "GET", "path": "/v1/projects/{project_id}/alias-proposals", "tag": "aliases", "summary": "Alternate-name proposals with evidence and collision result (D17)", "access": "session", "roles": "all", "query": ["status", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/AliasProposalPage" }, "errors": [404, 422] },
    { "operation_id": "decideAliasProposal", "method": "POST", "path": "/v1/alias-proposals/{proposal_id}/decisions", "tag": "aliases", "summary": "Approve (standalone or context-required), reject or revoke an alias", "access": "session", "roles": ["researcher", "moderator"], "request": "api.schema.json#/$defs/AliasDecisionRequest", "responses": { "200": "catalogue.schema.json#/$defs/AliasProposal" }, "errors": [404, 409, 422] },

    { "operation_id": "listFindings", "method": "GET", "path": "/v1/projects/{project_id}/findings", "tag": "findings", "summary": "Findings with exact claims, conflicts and eligibility", "access": "session", "roles": "all", "query": ["review_status", "kind", "aspect", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/FindingPage" }, "errors": [404, 422] },
    { "operation_id": "reviseFinding", "method": "POST", "path": "/v1/findings/{finding_id}/revisions", "tag": "findings", "summary": "Edit a finding as a new revision", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/FindingRevisionRequest", "responses": { "201": "evidence.schema.json#/$defs/Finding" }, "errors": [404, 409, 422] },
    { "operation_id": "decideFinding", "method": "POST", "path": "/v1/findings/{finding_id}/decisions", "tag": "findings", "summary": "Approve, reject or request changes on an exact finding revision", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/FindingDecisionRequest", "responses": { "200": "content.schema.json#/$defs/ReviewDecision" }, "errors": [404, 409, 422] },

    { "operation_id": "listReviewExcerpts", "method": "GET", "path": "/v1/projects/{project_id}/review-excerpts", "tag": "reviews", "summary": "First-person reviews from real posts, comments and videos, with original words, evidence and checks (D28)", "access": "session", "roles": "all", "query": ["review_status", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/ReviewExcerptPage" }, "errors": [404, 422] },
    { "operation_id": "reviseReviewExcerpt", "method": "POST", "path": "/v1/review-excerpts/{excerpt_id}/revisions", "tag": "reviews", "summary": "Choose different spans of the same source or fix a translation, as a new revision; no free-text rewrite", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/ReviewExcerptRevisionRequest", "responses": { "201": "evidence.schema.json#/$defs/ReviewExcerpt" }, "errors": [404, 409, 422] },
    { "operation_id": "decideReviewExcerpt", "method": "POST", "path": "/v1/review-excerpts/{excerpt_id}/decisions", "tag": "reviews", "summary": "Approve, reject or request changes on an exact review revision; flagged reviews cannot be approved", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/ReviewExcerptDecisionRequest", "responses": { "200": "content.schema.json#/$defs/ReviewDecision" }, "errors": [404, 409, 422] },

    { "operation_id": "createContentRevision", "method": "POST", "path": "/v1/projects/{project_id}/content-revisions", "tag": "content", "summary": "Generate from approved findings (202) or save a validated edit as a new revision (201)", "access": "session", "roles": ["moderator"], "idempotent": true, "request": "api.schema.json#/$defs/ContentRevisionRequest", "responses": { "201": "api.schema.json#/$defs/ContentRevisionView", "202": "api.schema.json#/$defs/Accepted" }, "errors": [404, 409, 422] },
    { "operation_id": "listContentRevisions", "method": "GET", "path": "/v1/projects/{project_id}/content-revisions", "tag": "content", "summary": "Content revision history", "access": "session", "roles": ["moderator", "publisher"], "query": ["lifecycle", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/ContentRevisionPage" }, "errors": [404, 422] },
    { "operation_id": "getContentRevision", "method": "GET", "path": "/v1/content-revisions/{revision_id}", "tag": "content", "summary": "Immutable payload, lineage, QA and private preview path", "access": "session", "roles": ["moderator", "publisher"], "responses": { "200": "api.schema.json#/$defs/ContentRevisionView" }, "errors": [404] },
    { "operation_id": "approveContentRevision", "method": "POST", "path": "/v1/content-revisions/{revision_id}/approvals", "tag": "content", "summary": "Final approval of the exact revision and hashes; the server recomputes and compares", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/ApprovalRequest", "responses": { "201": "content.schema.json#/$defs/ReviewDecision" }, "errors": [404, 409, 422] },
    { "operation_id": "decideContentRevision", "method": "POST", "path": "/v1/content-revisions/{revision_id}/decisions", "tag": "content", "summary": "Reject or request changes on the exact final revision", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/ContentDecisionRequest", "responses": { "200": "content.schema.json#/$defs/ReviewDecision" }, "errors": [404, 409, 422] },

    { "operation_id": "getPublicationState", "method": "GET", "path": "/v1/projects/{project_id}/publication", "tag": "publication", "summary": "Approved vs active vs delivered revision and recent operations", "access": "session", "roles": "all", "responses": { "200": "api.schema.json#/$defs/PublicationStateView" }, "errors": [404] },
    { "operation_id": "publish", "method": "POST", "path": "/v1/publications", "tag": "publication", "summary": "Activate an approved revision and deliver it to the public page", "access": "session", "roles": ["publisher"], "idempotent": true, "request": "api.schema.json#/$defs/PublicationRequest", "responses": { "202": "publication.schema.json#/$defs/PublicationOperation" }, "errors": [404, 409, 422] },
    { "operation_id": "getPublication", "method": "GET", "path": "/v1/publications/{operation_id}", "tag": "publication", "summary": "Activation vs delivery status and verified revision", "access": "session", "roles": ["publisher"], "responses": { "200": "publication.schema.json#/$defs/PublicationOperation" }, "errors": [404] },
    { "operation_id": "rollbackPublication", "method": "POST", "path": "/v1/publications/{operation_id}/rollback", "tag": "publication", "summary": "Roll back to an eligible prior revision as a new operation", "access": "session", "roles": ["publisher"], "idempotent": true, "request": "api.schema.json#/$defs/RollbackRequest", "responses": { "202": "publication.schema.json#/$defs/PublicationOperation" }, "errors": [404, 409, 422] },
    { "operation_id": "unpublishProject", "method": "POST", "path": "/v1/projects/{project_id}/unpublish", "tag": "publication", "summary": "Remove the module; the page shows the empty state", "access": "session", "roles": ["publisher"], "idempotent": true, "request": "api.schema.json#/$defs/UnpublishRequest", "responses": { "202": "publication.schema.json#/$defs/PublicationOperation" }, "errors": [404, 409, 422] },

    { "operation_id": "getPublicInsights", "method": "GET", "path": "/v1/public/projects/{slug}/insights", "tag": "public", "summary": "Public read of the active eligible revision only; never drafts", "access": "public", "roles": [], "responses": { "200": "api.schema.json#/$defs/PublicInsights" }, "errors": [404, 429] },
    { "operation_id": "submitCorrection", "method": "POST", "path": "/v1/public/projects/{slug}/corrections", "tag": "public", "summary": "Public correction or report into the moderation queue", "access": "public", "roles": [], "request": "api.schema.json#/$defs/CorrectionRequest", "responses": { "202": "api.schema.json#/$defs/CorrectionAck" }, "errors": [404, 422, 429] },
    { "operation_id": "listCorrections", "method": "GET", "path": "/v1/corrections", "tag": "corrections", "summary": "Correction queue", "access": "session", "roles": ["moderator"], "query": ["status", "project_id", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/CorrectionPage" }, "errors": [422] },
    { "operation_id": "decideCorrection", "method": "POST", "path": "/v1/corrections/{correction_id}/decisions", "tag": "corrections", "summary": "Resolve or dismiss a correction with a reason", "access": "session", "roles": ["moderator"], "request": "api.schema.json#/$defs/CorrectionDecisionRequest", "responses": { "200": "content.schema.json#/$defs/ReviewDecision" }, "errors": [404, 409, 422] },

    { "operation_id": "getConnectorHealth", "method": "GET", "path": "/v1/connectors/health", "tag": "connectors", "summary": "Entitlements, last success, quota and safe errors", "access": "session", "roles": ["researcher", "admin"], "responses": { "200": "api.schema.json#/$defs/ConnectorHealthList" }, "errors": [] },
    { "operation_id": "receiveWebhook", "method": "POST", "path": "/v1/webhooks/{provider}", "tag": "webhooks", "summary": "Provider webhook; verified signature, replay window and event ID", "access": "signature", "roles": [], "request": "inline:object", "responses": { "202": "api.schema.json#/$defs/WebhookAck" }, "errors": [401, 409, 422] },

    { "operation_id": "listJobs", "method": "GET", "path": "/v1/ops/jobs", "tag": "ops", "summary": "Durable jobs, filterable by status", "access": "session", "roles": ["researcher", "admin"], "query": ["job_status", "project_id", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/JobPage" }, "errors": [422] },
    { "operation_id": "getOpsSummary", "method": "GET", "path": "/v1/ops/summary", "tag": "ops", "summary": "Freshness, failures, delivery backlog, deletion backlog and model usage", "access": "session", "roles": "all", "responses": { "200": "api.schema.json#/$defs/OpsSummary" }, "errors": [] },
    { "operation_id": "listEvaluations", "method": "GET", "path": "/v1/evaluations", "tag": "ops", "summary": "Evaluation runs with sample sizes", "access": "session", "roles": "all", "query": ["cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/EvaluationPage" }, "errors": [422] },

    { "operation_id": "listUsers", "method": "GET", "path": "/v1/admin/users", "tag": "admin", "summary": "Users and roles", "access": "session", "roles": ["admin"], "query": ["cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/UserPage" }, "errors": [422] },
    { "operation_id": "createUser", "method": "POST", "path": "/v1/admin/users", "tag": "admin", "summary": "Create a user (no self-registration)", "access": "session", "roles": ["admin"], "request": "api.schema.json#/$defs/UserCreateRequest", "responses": { "201": "api.schema.json#/$defs/UserView" }, "errors": [409, 422] },
    { "operation_id": "updateUser", "method": "PATCH", "path": "/v1/admin/users/{user_id}", "tag": "admin", "summary": "Change roles, name or active flag", "access": "session", "roles": ["admin"], "request": "api.schema.json#/$defs/UserUpdateRequest", "responses": { "200": "api.schema.json#/$defs/UserView" }, "errors": [404, 422] },
    { "operation_id": "listSourcePolicies", "method": "GET", "path": "/v1/admin/source-policies", "tag": "admin", "summary": "Source policy versions", "access": "session", "roles": ["admin", "researcher"], "query": ["cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/PolicyPage" }, "errors": [422] },
    { "operation_id": "createSourcePolicyVersion", "method": "POST", "path": "/v1/admin/source-policies", "tag": "admin", "summary": "Create the next immutable policy version for a family", "access": "session", "roles": ["admin"], "idempotent": true, "request": "api.schema.json#/$defs/PolicyVersionRequest", "responses": { "201": "sources.schema.json#/$defs/SourcePolicy" }, "errors": [409, 422] },
    { "operation_id": "listAuditEvents", "method": "GET", "path": "/v1/admin/audit-events", "tag": "admin", "summary": "Audit search", "access": "session", "roles": ["admin"], "query": ["target_type", "target_id", "from", "to", "cursor", "limit"], "responses": { "200": "api.schema.json#/$defs/AuditEventPage" }, "errors": [422] }
  ],
  "query_parameters": {
    "cursor": { "type": "string" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
    "connector_id": { "$ref": "common.schema.json#/$defs/ConnectorId" },
    "source_kind": { "$ref": "common.schema.json#/$defs/SourceKind" },
    "aspect": { "$ref": "common.schema.json#/$defs/Aspect" },
    "language": { "$ref": "common.schema.json#/$defs/LanguageTag" },
    "published_from": { "$ref": "common.schema.json#/$defs/Date" },
    "published_to": { "$ref": "common.schema.json#/$defs/Date" },
    "access_status": { "$ref": "common.schema.json#/$defs/MediaAccessStatus" },
    "format": { "enum": ["video", "short", "unknown"] },
    "status": { "type": "string" },
    "review_status": { "$ref": "common.schema.json#/$defs/FindingReviewStatus" },
    "kind": { "$ref": "common.schema.json#/$defs/FindingKind" },
    "lifecycle": { "$ref": "common.schema.json#/$defs/ContentLifecycle" },
    "job_status": { "$ref": "common.schema.json#/$defs/JobStatus" },
    "project_id": { "$ref": "common.schema.json#/$defs/ProjectId" },
    "target_type": { "type": "string" },
    "target_id": { "type": "string" },
    "from": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "to": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "path_parameters": {
    "project_id": { "$ref": "common.schema.json#/$defs/ProjectId" },
    "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
    "source_id": { "$ref": "common.schema.json#/$defs/SourceId" },
    "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" },
    "link_id": { "$ref": "common.schema.json#/$defs/SourceLinkId" },
    "proposal_id": { "$ref": "common.schema.json#/$defs/AliasProposalId" },
    "finding_id": { "$ref": "common.schema.json#/$defs/FindingId" },
    "revision_id": { "$ref": "common.schema.json#/$defs/ContentRevisionId" },
    "operation_id": { "$ref": "common.schema.json#/$defs/PublicationOperationId" },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "provider": { "$ref": "common.schema.json#/$defs/ConnectorId" },
    "correction_id": { "$ref": "common.schema.json#/$defs/CorrectionId" },
    "excerpt_id": { "$ref": "common.schema.json#/$defs/ReviewExcerptId" },
    "user_id": { "$ref": "common.schema.json#/$defs/UserId" }
  }
}
