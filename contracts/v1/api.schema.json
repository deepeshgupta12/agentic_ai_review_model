{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API request and response shapes",
  "description": "Bodies and views used by contracts/v1/openapi.json (docs/03). Actor identity is never accepted from a request body; the backend derives it from the session.",
  "x-contract-version": "1.2.0",
  "$defs": {
    "LoginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "password"],
      "properties": { "email": { "type": "string", "minLength": 3 }, "password": { "type": "string", "minLength": 1 } }
    },
    "UserView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "display_name", "roles", "active"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/UserId" },
        "email": { "type": "string" },
        "display_name": { "type": "string" },
        "roles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Role" } },
        "active": { "type": "boolean" }
      }
    },
    "AuthSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "csrf_token", "expires_at"],
      "properties": {
        "user": { "$ref": "#/$defs/UserView" },
        "csrf_token": { "type": "string", "minLength": 16 },
        "expires_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "Accepted": {
      "description": "202 response for long work: poll the resource or subscribe to run events.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "run_id", "operation_id", "status_path"],
      "properties": {
        "job_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/JobId" }, { "type": "null" }] },
        "run_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/RunId" }, { "type": "null" }] },
        "operation_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "status_path": { "type": "string", "pattern": "^/v1/" }
      }
    },
    "ImportResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects"],
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_id", "slug", "project_name", "created"],
            "properties": {
              "project_id": { "$ref": "common.schema.json#/$defs/ProjectId" },
              "slug": { "$ref": "common.schema.json#/$defs/Slug" },
              "project_name": { "type": "string" },
              "created": { "type": "boolean" }
            }
          }
        }
      }
    },
    "ProjectSummary": {
      "description": "Portfolio row.",
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "latest_run", "coverage", "pending_review", "publication", "stale", "spend_usd_30d"],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "slug", "project_name", "locality", "city"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/ProjectId" },
            "slug": { "$ref": "common.schema.json#/$defs/Slug" },
            "project_name": { "type": "string" },
            "locality": { "type": "string" },
            "city": { "type": "string" }
          }
        },
        "latest_run": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "stage", "updated_at"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/RunId" },
                "stage": { "$ref": "common.schema.json#/$defs/WorkflowStage" },
                "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
              }
            },
            { "type": "null" }
          ]
        },
        "coverage": { "type": "array", "items": { "$ref": "operations.schema.json#/$defs/RunCoverage" } },
        "pending_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["findings", "review_excerpts", "links", "alias_proposals", "corrections"],
          "properties": {
            "findings": { "type": "integer", "minimum": 0 },
            "review_excerpts": { "type": "integer", "minimum": 0 },
            "links": { "type": "integer", "minimum": 0 },
            "alias_proposals": { "type": "integer", "minimum": 0 },
            "corrections": { "type": "integer", "minimum": 0 }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serving_state", "approved_revision", "active_revision", "delivery_status"],
          "properties": {
            "serving_state": { "$ref": "common.schema.json#/$defs/ServingState" },
            "approved_revision": { "anyOf": [{ "$ref": "common.schema.json#/$defs/RevisionNumber" }, { "type": "null" }] },
            "active_revision": { "anyOf": [{ "$ref": "common.schema.json#/$defs/RevisionNumber" }, { "type": "null" }] },
            "delivery_status": { "anyOf": [{ "$ref": "common.schema.json#/$defs/PublicationOperationStatus" }, { "type": "null" }] }
          }
        },
        "stale": { "type": "boolean" },
        "spend_usd_30d": { "type": "number", "minimum": 0 }
      }
    },
    "ProjectPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ProjectSummary" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "ProjectDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "config"],
      "properties": {
        "project": { "$ref": "catalogue.schema.json#/$defs/Project" },
        "config": { "$ref": "catalogue.schema.json#/$defs/ProjectConfig" }
      }
    },
    "ProjectConfigPatch": {
      "description": "Only the listed fields change. Aliases with origin approved_proposal are changed through alias decisions, not here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_version"],
      "minProperties": 2,
      "properties": {
        "expected_version": { "$ref": "common.schema.json#/$defs/Version" },
        "negative_keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "input_languages": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/LanguageTag" } },
        "refresh": { "$ref": "catalogue.schema.json#/$defs/ProjectConfig/properties/refresh" },
        "sources": { "$ref": "catalogue.schema.json#/$defs/ProjectConfig/properties/sources" },
        "construction_status": { "$ref": "catalogue.schema.json#/$defs/ProjectConfig/properties/construction_status" }
      }
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_days", "connectors"],
      "properties": {
        "window_days": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 3650 }, { "type": "null" }] },
        "connectors": { "anyOf": [{ "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/ConnectorId" } }, { "type": "null" }] }
      }
    },
    "RunPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "operations.schema.json#/$defs/WorkflowRun" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "ReasonRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 1000 } }
    },
    "RunEvent": {
      "description": "Server-sent event payload. The SSE id field carries event_id for resumption.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "run_id", "type", "at", "stage", "coverage", "message"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
        "type": { "enum": ["stage_changed", "coverage_updated", "progress", "error", "completed"] },
        "at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "stage": { "$ref": "common.schema.json#/$defs/WorkflowStage" },
        "coverage": { "anyOf": [{ "$ref": "operations.schema.json#/$defs/RunCoverage" }, { "type": "null" }] },
        "message": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "SourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "connector_id", "source_kind", "title", "canonical_url", "publication_date", "language", "capture_level", "lifecycle", "link_status", "aspects"],
      "properties": {
        "source": { "$ref": "common.schema.json#/$defs/SourceRevisionRef" },
        "connector_id": { "$ref": "common.schema.json#/$defs/ConnectorId" },
        "source_kind": { "$ref": "common.schema.json#/$defs/SourceKind" },
        "title": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "canonical_url": { "$ref": "common.schema.json#/$defs/HttpUrl" },
        "publication_date": { "$ref": "common.schema.json#/$defs/DatedValue" },
        "language": { "anyOf": [{ "$ref": "common.schema.json#/$defs/LanguageTag" }, { "type": "null" }] },
        "capture_level": { "$ref": "common.schema.json#/$defs/CaptureLevel" },
        "lifecycle": { "$ref": "common.schema.json#/$defs/RecordLifecycle" },
        "link_status": { "$ref": "common.schema.json#/$defs/SourceLinkStatus" },
        "aspects": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Aspect" } }
      }
    },
    "SourcePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/SourceSummary" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "EvidenceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "anchor_view", "eligible", "ineligibility_reasons"],
      "properties": {
        "evidence": { "$ref": "evidence.schema.json#/$defs/Evidence" },
        "anchor_view": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/TextAnchorView" }, { "$ref": "common.schema.json#/$defs/TimeAnchor" }]
        },
        "eligible": { "type": "boolean" },
        "ineligibility_reasons": {
          "type": "array",
          "items": { "enum": ["policy_disallows", "source_withdrawn", "source_deleted", "policy_expired", "link_not_accepted", "superseded", "source_unavailable"] }
        }
      }
    },
    "SourceRevisionDetail": {
      "description": "Only project-scoped associations the caller may see; permitted text only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "permitted_text", "links", "evidence"],
      "properties": {
        "source": { "$ref": "sources.schema.json#/$defs/SourceRevision" },
        "permitted_text": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "links": { "type": "array", "items": { "$ref": "sources.schema.json#/$defs/ProjectSourceLink" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceView" } }
      }
    },
    "MediaItemView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "link_status", "segments"],
      "properties": {
        "source": { "$ref": "sources.schema.json#/$defs/SourceRevision" },
        "link_status": { "$ref": "common.schema.json#/$defs/SourceLinkStatus" },
        "segments": { "type": "array", "items": { "$ref": "sources.schema.json#/$defs/MediaSegment" } }
      }
    },
    "MediaPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/MediaItemView" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "LinkDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expected_version", "reason", "split_segments", "remap_project_id", "phase_rera_id"],
      "properties": {
        "action": { "enum": ["accept", "reject", "split", "remap"] },
        "expected_version": { "$ref": "common.schema.json#/$defs/Version" },
        "reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "split_segments": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["segment_key", "anchor", "project_id"],
                "properties": {
                  "segment_key": { "type": "string", "pattern": "^(c:\\d+-\\d+|t:\\d+-\\d+)$" },
                  "anchor": { "$ref": "common.schema.json#/$defs/Anchor" },
                  "project_id": { "$ref": "common.schema.json#/$defs/ProjectId" }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "remap_project_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/ProjectId" }, { "type": "null" }] },
        "phase_rera_id": { "anyOf": [{ "type": "string", "pattern": "^[A-Z0-9/]+$" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["reject", "split", "remap"] } } },
          "then": { "properties": { "reason": { "type": "string" } } }
        },
        {
          "if": { "properties": { "action": { "const": "split" } } },
          "then": { "properties": { "split_segments": { "type": "array" } } },
          "else": { "properties": { "split_segments": { "type": "null" } } }
        },
        {
          "if": { "properties": { "action": { "const": "remap" } } },
          "then": { "properties": { "remap_project_id": { "$ref": "common.schema.json#/$defs/ProjectId" } } },
          "else": { "properties": { "remap_project_id": { "type": "null" } } }
        }
      ]
    },
    "AliasProposalPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "catalogue.schema.json#/$defs/AliasProposal" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "AliasDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "mode", "reason", "expected_version"],
      "properties": {
        "action": { "enum": ["approve", "reject", "revoke"] },
        "mode": { "anyOf": [{ "$ref": "common.schema.json#/$defs/AliasMode" }, { "type": "null" }] },
        "reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "expected_version": { "$ref": "common.schema.json#/$defs/Version" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "approve" } } },
          "then": { "properties": { "mode": { "$ref": "common.schema.json#/$defs/AliasMode" } } },
          "else": { "properties": { "mode": { "type": "null" }, "reason": { "type": "string" } } }
        }
      ]
    },
    "FindingView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding", "claims", "evidence", "eligible", "ineligibility_reasons", "decisions"],
      "properties": {
        "finding": { "$ref": "evidence.schema.json#/$defs/Finding" },
        "claims": { "type": "array", "items": { "$ref": "evidence.schema.json#/$defs/Claim" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceView" } },
        "eligible": { "type": "boolean" },
        "ineligibility_reasons": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "$ref": "content.schema.json#/$defs/ReviewDecision" } }
      }
    },
    "FindingPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/FindingView" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "FindingRevisionRequest": {
      "description": "An edit always creates a new revision from an exact base revision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "kind", "aspect", "wording", "attribution", "claims", "caveats", "reason"],
      "properties": {
        "base": { "$ref": "common.schema.json#/$defs/FindingRef" },
        "kind": { "$ref": "common.schema.json#/$defs/FindingKind" },
        "aspect": { "$ref": "common.schema.json#/$defs/Aspect" },
        "wording": { "type": "string", "minLength": 1 },
        "attribution": { "$ref": "common.schema.json#/$defs/Attribution" },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/ClaimRef" } },
        "caveats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "FindingDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "action", "reason"],
      "properties": {
        "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" },
        "action": { "enum": ["approve", "reject", "changes_requested"] },
        "reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["reject", "changes_requested"] } } },
          "then": { "properties": { "reason": { "type": "string" } } }
        }
      ]
    },
    "ContentRevisionRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "locale", "findings", "reviews"],
          "properties": {
            "mode": { "const": "generate" },
            "locale": { "$ref": "common.schema.json#/$defs/Locale" },
            "findings": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/FindingRef" } },
            "reviews": {
              "description": "Approved review excerpts to show, positive and negative; may be empty.",
              "type": "array",
              "items": { "$ref": "#/$defs/ReviewExcerptRef" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "locale", "base", "payload", "reason"],
          "properties": {
            "mode": { "const": "edit" },
            "locale": { "$ref": "common.schema.json#/$defs/Locale" },
            "base": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/ContentRevisionId" },
                "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" }
              }
            },
            "payload": { "$ref": "content.schema.json#/$defs/ContentPayload" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "ReviewExcerptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/ReviewExcerptId" },
        "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" }
      }
    },
    "ReviewExcerptView": {
      "description": "A proposed or approved review with the original words and the evidence behind it, for moderators.",
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "evidence", "source_url", "rendering_check", "decisions"],
      "properties": {
        "review": { "$ref": "evidence.schema.json#/$defs/ReviewExcerpt" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceView" } },
        "source_url": { "$ref": "common.schema.json#/$defs/HttpUrl" },
        "rendering_check": {
          "description": "Backend comparison of text with original_text; translated reviews show 'needs_moderator'.",
          "enum": ["matches_original", "needs_moderator", "mismatch"]
        },
        "decisions": { "type": "array", "items": { "$ref": "content.schema.json#/$defs/ReviewDecision" } }
      }
    },
    "ReviewExcerptPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ReviewExcerptView" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "ReviewExcerptDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "action", "reason"],
      "properties": {
        "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" },
        "action": { "enum": ["approve", "reject", "changes_requested"] },
        "reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["reject", "changes_requested"] } } },
          "then": { "properties": { "reason": { "type": "string" } } }
        }
      ]
    },
    "ReviewExcerptRevisionRequest": {
      "description": "Choose different spans of the same source or fix a translation. The words must still be the author's; there is no free-text rewrite.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "evidence", "rendering", "text", "reason"],
      "properties": {
        "base": { "$ref": "#/$defs/ReviewExcerptRef" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" } },
        "rendering": { "$ref": "common.schema.json#/$defs/ReviewRendering" },
        "text": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ContentRevisionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "preview_path", "is_approved", "is_active"],
      "properties": {
        "revision": { "$ref": "content.schema.json#/$defs/ContentRevision" },
        "preview_path": { "type": "string", "pattern": "^/console/" },
        "is_approved": { "type": "boolean" },
        "is_active": { "type": "boolean" }
      }
    },
    "ContentRevisionPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ContentRevisionView" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "ApprovalRequest": {
      "description": "Final approval names the exact revision, hashes, epoch and state version the moderator saw. The server recomputes and compares.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "payload_sha256", "manifest_sha256", "eligibility_epoch", "expected_state_version"],
      "properties": {
        "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" },
        "payload_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "manifest_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "eligibility_epoch": { "type": "integer", "minimum": 0 },
        "expected_state_version": { "$ref": "common.schema.json#/$defs/Version" }
      }
    },
    "ContentDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "action", "reason"],
      "properties": {
        "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" },
        "action": { "enum": ["reject", "changes_requested"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "PublicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "locale", "revision_id", "payload_sha256", "expected_state_version"],
      "properties": {
        "project_id": { "$ref": "common.schema.json#/$defs/ProjectId" },
        "locale": { "$ref": "common.schema.json#/$defs/Locale" },
        "revision_id": { "$ref": "common.schema.json#/$defs/ContentRevisionId" },
        "payload_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "expected_state_version": { "$ref": "common.schema.json#/$defs/Version" }
      }
    },
    "RollbackRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_revision_id", "reason", "expected_state_version"],
      "properties": {
        "target_revision_id": { "$ref": "common.schema.json#/$defs/ContentRevisionId" },
        "reason": { "type": "string", "minLength": 1 },
        "expected_state_version": { "$ref": "common.schema.json#/$defs/Version" }
      }
    },
    "UnpublishRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "current_revision_id", "reason", "expected_state_version"],
      "properties": {
        "locale": { "$ref": "common.schema.json#/$defs/Locale" },
        "current_revision_id": { "$ref": "common.schema.json#/$defs/ContentRevisionId" },
        "reason": { "type": "string", "minLength": 1 },
        "expected_state_version": { "$ref": "common.schema.json#/$defs/Version" }
      }
    },
    "PublicationStateView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "recent_operations"],
      "properties": {
        "state": { "$ref": "publication.schema.json#/$defs/PublicationState" },
        "recent_operations": { "type": "array", "maxItems": 50, "items": { "$ref": "publication.schema.json#/$defs/PublicationOperation" } }
      }
    },
    "WithdrawalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "revision", "reason"],
      "properties": {
        "scope": { "enum": ["source_revision", "source_all_revisions"] },
        "revision": { "anyOf": [{ "$ref": "common.schema.json#/$defs/RevisionNumber" }, { "type": "null" }] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "source_revision" } } },
          "then": { "properties": { "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" } } },
          "else": { "properties": { "revision": { "type": "null" } } }
        }
      ]
    },
    "ConnectorHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "status", "last_verified", "last_success_at", "quota", "last_error"],
      "properties": {
        "connector_id": { "$ref": "common.schema.json#/$defs/ConnectorId" },
        "status": { "$ref": "common.schema.json#/$defs/ConnectorStatus" },
        "last_verified": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Date" }, { "type": "null" }] },
        "last_success_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "used", "resets_at"],
          "properties": {
            "limit": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
            "used": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
            "resets_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] }
          }
        },
        "last_error": {
          "description": "Safe message only; never a credential or raw provider body.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "at"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string", "maxLength": 300 },
                "at": { "$ref": "common.schema.json#/$defs/Timestamp" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "ConnectorHealthList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectors"],
      "properties": { "connectors": { "type": "array", "items": { "$ref": "#/$defs/ConnectorHealth" } } }
    },
    "PublicInsights": {
      "description": "Public read: only the active, eligible revision. The marker values are embedded in the page for delivery verification.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "revision", "payload_sha256", "payload"],
      "properties": {
        "revision_id": { "$ref": "common.schema.json#/$defs/ContentRevisionId" },
        "revision": { "$ref": "common.schema.json#/$defs/RevisionNumber" },
        "payload_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "payload": { "$ref": "content.schema.json#/$defs/ContentPayload" }
      }
    },
    "CorrectionRequest": {
      "description": "Public correction/report. 'website' is a honeypot and must stay empty.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "contact", "revision_id", "website"],
      "properties": {
        "message": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "contact": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
        "revision_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/ContentRevisionId" }, { "type": "null" }] },
        "website": { "const": "" }
      }
    },
    "CorrectionAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_id", "status"],
      "properties": {
        "correction_id": { "$ref": "common.schema.json#/$defs/CorrectionId" },
        "status": { "const": "received" }
      }
    },
    "CorrectionPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "operations.schema.json#/$defs/PublicCorrection" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "CorrectionDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": { "enum": ["resolve", "dismiss"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "JobPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "operations.schema.json#/$defs/Job" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "OpsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "delivery_pending", "deletion_backlog", "model_usage"],
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_id", "newest_evidence_at", "active_revision_age_days", "stale", "failed_jobs", "spend_usd_30d"],
            "properties": {
              "project_id": { "$ref": "common.schema.json#/$defs/ProjectId" },
              "newest_evidence_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
              "active_revision_age_days": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
              "stale": { "type": "boolean" },
              "failed_jobs": { "type": "integer", "minimum": 0 },
              "spend_usd_30d": { "type": "number", "minimum": 0 }
            }
          }
        },
        "delivery_pending": { "type": "integer", "minimum": 0 },
        "deletion_backlog": { "type": "integer", "minimum": 0 },
        "model_usage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "calls", "input_tokens", "output_tokens", "cost_usd"],
            "properties": {
              "agent": { "$ref": "common.schema.json#/$defs/AgentId" },
              "calls": { "type": "integer", "minimum": 0 },
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 },
              "cost_usd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "EvaluationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "operations.schema.json#/$defs/EvaluationRun" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "UserPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/UserView" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "UserCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "display_name", "roles", "password"],
      "properties": {
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
        "display_name": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Role" } },
        "password": { "type": "string", "minLength": 12 }
      }
    },
    "UserUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Role" } },
        "active": { "type": "boolean" }
      }
    },
    "PolicyPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "sources.schema.json#/$defs/SourcePolicy" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "PolicyVersionRequest": {
      "description": "Creates the next immutable policy_version for a family; the backend runs dependency invalidation if rights narrow.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "collection_allowed",
        "ai_processing_allowed",
        "quotation_allowed",
        "derived_publication_allowed",
        "attribution_required",
        "retention_days",
        "hosts",
        "excluded_hosts",
        "conditions",
        "basis",
        "effective_from",
        "expires_at"
      ],
      "properties": {
        "family": { "$ref": "common.schema.json#/$defs/PolicyFamily" },
        "collection_allowed": { "type": "boolean" },
        "ai_processing_allowed": { "type": "boolean" },
        "quotation_allowed": { "type": "boolean" },
        "derived_publication_allowed": { "type": "boolean" },
        "attribution_required": { "type": "boolean" },
        "retention_days": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "excluded_hosts": { "type": "array", "items": { "type": "string" } },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "robots_txt": { "description": "Optional; obey when omitted (D46)", "enum": ["obey", "record_only"] },
        "basis": { "type": "string", "minLength": 1 },
        "effective_from": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "expires_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "AuditEventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "operations.schema.json#/$defs/AuditEvent" } },
        "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "WebhookAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "event_id"],
      "properties": { "accepted": { "type": "boolean" }, "event_id": { "type": "string" } }
    }
  }
}
