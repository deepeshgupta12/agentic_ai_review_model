# Copy to .env with `make env` (keeps your values, generates secrets). Never commit .env.
# Mode: fixture (default; can never publish) or live (fails fast without its secrets).
APP_MODE=fixture
LOG_LEVEL=INFO

# Host tools connect directly; containers override MONGODB_URI in docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=sy_poc

# 32+ characters each; `make env` generates them.
SESSION_SECRET=
REVALIDATION_SECRET=
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Model provider (D07, D10). Empty key: the anthropic connector stays access_pending.
ANTHROPIC_API_KEY=
# Only for an organisation-level key (not scoped to a workspace): the workspace ID, wrkspc_...
ANTHROPIC_WORKSPACE_ID=
MODEL_ROUTINE=claude-sonnet-5
MODEL_REASONING=claude-sonnet-5
MODEL_DIFFICULT=claude-opus-5-5
# Claude spend: the total for all runs (default 3) and the most one run may spend (default 5). To raise them, add
# the lines without "#" and a value in .env, then restart the stack (docker compose up -d).
# MODEL_BUDGET_USD=
# RUN_BUDGET_USD=

# Source connectors (seed/connectors.json). Each stays access_pending until demonstrated.
BRAVE_SEARCH_API_KEY=
# Scrapfly (Instagram public posts through its bot-protection handling and residential proxies; product owner, 9 Oct 2026, I20)
SCRAPFLY_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
META_ACCESS_TOKEN=
LISTENING_PROVIDER_API_KEY=

# Password for the seeded coordinator (I09). Leave empty to type it when `make seed-users` asks.
SEED_USER_PASSWORD=

# Step 06 media worker (D48): CPUs it may use; empty means 2. Memory is capped at 2 GB in docker-compose.yml
MEDIA_WORKER_CPUS=

# Step 07 embedder (D51): CPUs it may use; empty means 2. Memory is capped at 1.5 GB in docker-compose.yml
EMBEDDER_CPUS=
