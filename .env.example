# Copy to .env with `make env` (keeps your values, generates secrets). Never commit .env.
# Mode: fixture (default; can never publish) or live (fails fast without its secrets).
APP_MODE=fixture
LOG_LEVEL=INFO

# Host tools connect directly; containers override MONGODB_URI in docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=sy_poc

# 32+ characters each; `make env` generates them.
SESSION_SECRET=
REVALIDATION_SECRET=
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Model provider (D07, D10). Empty key: the anthropic connector stays access_pending.
ANTHROPIC_API_KEY=
MODEL_ROUTINE=claude-sonnet-5
MODEL_REASONING=claude-sonnet-5
MODEL_DIFFICULT=claude-opus-5-5

# Source connectors (seed/connectors.json). Each stays access_pending until demonstrated.
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
META_ACCESS_TOKEN=
LISTENING_PROVIDER_API_KEY=

# Password for the seeded coordinator (I09). Leave empty to type it when `make seed-users` asks.
SEED_USER_PASSWORD=
