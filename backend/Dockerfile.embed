# Embedder image (Step 07, D51): the backend plus the `embed` dependency group (onnxruntime, tokenizers,
# huggingface-hub). It serves bge-m3 int8 embeddings on the Compose network only. No torch, no GPU.
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /srv/backend
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-dev --group embed --no-install-project
COPY backend/app ./app
RUN uv sync --frozen --no-dev --group embed

COPY contracts /srv/contracts
COPY seed /srv/seed

RUN useradd --system --uid 10001 --create-home app \
 && mkdir -p /srv/embeddings \
 && chown app /srv/embeddings
USER app
ENV HOME=/home/app
EXPOSE 8100
CMD ["uvicorn", "app.embeddings.server:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "1", "--no-access-log"]
