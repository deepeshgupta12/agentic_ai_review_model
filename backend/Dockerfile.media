# Media worker image (Step 06, D47): the backend plus ffmpeg and the `media` dependency group (captions, yt-dlp,
# faster-whisper). Only this image can download or transcribe; it takes only process_media jobs (WORKER_ROLE=media).
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /uvx /bin/
# Debian over HTTPS: plain HTTP (port 80) is blocked on the build network.
RUN sed -i "s|http://deb.debian.org|https://deb.debian.org|g" /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_COMPILE_BYTECODE_TIMEOUT=600 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /srv/backend
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-dev --group media --no-install-project
COPY backend/app ./app
RUN uv sync --frozen --no-dev --group media

COPY contracts /srv/contracts
COPY seed /srv/seed
COPY prompts /srv/prompts
COPY evals /srv/evals

RUN useradd --system --uid 10001 --create-home app \
 && mkdir -p /srv/models /tmp/media \
 && chown app /srv/models /tmp/media
USER app
ENV HOME=/home/app
CMD ["python", "-m", "app.workers.worker"]
